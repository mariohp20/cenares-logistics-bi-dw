    <entry>
      <name>Poblar_Datamart_Estrella</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>-- ====================================================================
-- PASO 1: POBLADO DE DIMENSIONES (Evitando duplicados con ON CONFLICT)
-- ====================================================================

INSERT INTO datamart.dim_tiempo (fecha, anio, mes)
SELECT DISTINCT fecha_pecosa, anio_pecosa, TO_CHAR(fecha_pecosa, 'Month') 
FROM staging.stg_despachos 
WHERE fecha_pecosa IS NOT NULL
ON CONFLICT DO NOTHING;

INSERT INTO datamart.dim_producto (codigo_siga, codigo_sismed, descripcion)
SELECT DISTINCT codigo_siga, codigo_sismed, descripcion_producto 
FROM staging.stg_despachos 
WHERE codigo_siga IS NOT NULL
ON CONFLICT DO NOTHING;

INSERT INTO datamart.dim_ubicacion (cod_ue, departamento, provincia, distrito, categoria_establecimiento, coordenada_norte, coordenada_este)
SELECT DISTINCT cod_ue, departamento, provincia, distrito, categoria_establecimiento, coordenada_norte, coordenada_este 
FROM staging.stg_despachos 
WHERE cod_ue IS NOT NULL
ON CONFLICT DO NOTHING;

INSERT INTO datamart.dim_proveedor (ruc_proveedor, razon_social)
SELECT DISTINCT ruc_proveedor, nombre_proveedor 
FROM staging.stg_despachos 
WHERE ruc_proveedor IS NOT NULL
ON CONFLICT DO NOTHING;

INSERT INTO datamart.dim_almacen (condicion_frio)
SELECT DISTINCT CASE WHEN es_refrigerado = 1 THEN 'REFRIGERADO' ELSE 'CARGA SECA' END 
FROM staging.stg_despachos
ON CONFLICT DO NOTHING;

INSERT INTO datamart.dim_estrategia (estrategia, meta)
SELECT DISTINCT estrategia, meta 
FROM staging.stg_despachos 
WHERE estrategia IS NOT NULL
ON CONFLICT DO NOTHING;

-- ====================================================================
-- PASO 2: POBLADO DE TABLA DE HECHOS (INTELIGENTE: UPSERT REAL)
-- ====================================================================
INSERT INTO datamart.fact_logistica (
    id_tiempo, id_producto, id_ubicacion, id_proveedor, 
    id_almacen, id_estrategia, nro_pecosa, cantidad_despachada, lead_time_dias
)
SELECT 
    dt.id_tiempo,
    dp.id_producto,
    du.id_ubicacion,
    dprov.id_proveedor,
    da.id_almacen,
    de.id_estrategia,
    s.nro_pecosa,
    s.cantidad_despachada,
    (s.fecha_pecosa - s.fecha_creacion_registro) AS lead_time_dias -- Eliminamos ABS() para detectar errores de digitación en origen
FROM staging.stg_despachos s
LEFT JOIN datamart.dim_tiempo dt ON s.fecha_pecosa = dt.fecha
LEFT JOIN datamart.dim_producto dp ON s.codigo_siga = dp.codigo_siga
LEFT JOIN datamart.dim_ubicacion du ON s.cod_ue = du.cod_ue
LEFT JOIN datamart.dim_proveedor dprov ON s.ruc_proveedor = dprov.ruc_proveedor
LEFT JOIN datamart.dim_almacen da ON (CASE WHEN s.es_refrigerado = 1 THEN 'REFRIGERADO' ELSE 'CARGA SECA' END) = da.condicion_frio
LEFT JOIN datamart.dim_estrategia de ON s.estrategia = de.estrategia AND s.meta = de.meta
WHERE s.nro_pecosa IS NOT NULL AND s.fecha_creacion_registro IS NOT NULL

-- LA VACUNA ANTI-DUPLICADOS Y ACTUALIZADORA:
ON CONFLICT (nro_pecosa, id_producto) 
DO UPDATE SET 
    id_tiempo = EXCLUDED.id_tiempo,
    id_ubicacion = EXCLUDED.id_ubicacion,
    id_proveedor = EXCLUDED.id_proveedor,
    id_almacen = EXCLUDED.id_almacen,
    id_estrategia = EXCLUDED.id_estrategia,
    cantidad_despachada = EXCLUDED.cantidad_despachada,
    lead_time_dias = EXCLUDED.lead_time_dias;
-- ====================================================================
-- PASO 3: LIMPIEZA DE LA CAPA INICIAL (Mesa limpia para el próximo mes)
-- ====================================================================
TRUNCATE TABLE staging.stg_despachos;</sql>
